# ─── Backend (.env) ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://xlnet_user:xlnet_password@localhost:5432/xlnet_db?schema=public"

# JWT
JWT_SECRET=xlnet-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
